[Unit]
Description=Sexy Prime Bot ADS
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/sexy-prime-ads
EnvironmentFile=/opt/sexy-prime-ads/.env
ExecStart=/opt/sexy-prime-ads/.venv/bin/python /opt/sexy-prime-ads/bot.py
Restart=always
RestartSec=5
User=www-data
Group=www-data

[Install]
WantedBy=multi-user.target
